# ==========================================================
# CivicVision AI - Root Environment Configuration
# Copy this file to .env and fill in real values.
# Individual services (backend, frontend, ai-service) also
# have their own .env.example files for service-specific vars.
# ==========================================================

# ---------- General ----------
NODE_ENV=development
APP_NAME=CivicVision AI
APP_VERSION=1.0.0

# ---------- Backend ----------
BACKEND_PORT=5000
BACKEND_HOST=0.0.0.0
API_VERSION=v1

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_AI_SERVICE_URL=http://localhost:8000

# ---------- AI Service ----------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
LOG_LEVEL=info
MODEL_WEIGHTS_PATH=
YOLO_CONFIDENCE_THRESHOLD=0.25

# ---------- PostgreSQL ----------
POSTGRES_USER=civicvision
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=civicvision_db
POSTGRES_PORT=5432
# NOTE: used for non-Docker local dev (e.g. `npm run dev:backend` against
# a Postgres running directly on your machine). When running via
# `docker compose up`, the backend's DATABASE_URL is constructed
# automatically using Docker's internal service DNS (postgres:5432)
# instead — see docker-compose.yml.
DATABASE_URL=postgresql://civicvision:changeme_in_production@localhost:5432/civicvision_db?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Same note as DATABASE_URL above — docker-compose overrides this to
# redis:6379 automatically for containers.
REDIS_URL=redis://localhost:6379

# ---------- Auth ----------
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_another_strong_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
ADMIN_SECRET_PASSPHRASE=replace_with_strong_admin_passphrase

# ---------- CORS ----------
CORS_ORIGIN=http://localhost:5173

# ---------- MLflow (AI Service) ----------
MLFLOW_TRACKING_URI=http://localhost:5001
