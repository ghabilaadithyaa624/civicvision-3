# CivicVision AI — AI Service environment variables

APP_NAME=CivicVision AI Service
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

CORS_ORIGIN=http://localhost:5173

# Left unset in development — the detector service loads the model
# lazily, so /health works fine without this. Set it once real weights
# are staged (e.g. after training, or downloading a pretrained checkpoint).
MODEL_WEIGHTS_PATH=
YOLO_CONFIDENCE_THRESHOLD=0.25

MLFLOW_TRACKING_URI=http://localhost:5001
