# CivicVision AI — Backend service environment variables
# Copy to .env for local (non-Docker) development.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0
API_VERSION=v1
APP_NAME=CivicVision AI
APP_VERSION=1.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ---------- Reserved for Module 3 (database layer) ----------
DATABASE_URL=postgresql://civicvision:changeme_in_production@localhost:5432/civicvision_db?schema=public
REDIS_URL=redis://localhost:6379

# ---------- Reserved for the auth module ----------
JWT_SECRET=replace_with_strong_random_secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
